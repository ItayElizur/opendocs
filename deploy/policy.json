{
  // OpenDocs administrator policy, for every user of this computer. Restart Office after changing this file.
  // App names: "Word", "Excel", "PowerPoint", "Outlook".
  // Mode names: "readOnly", "commentOnly", "trackChanges", "fullAutonomy".
  // In Outlook, commentOnly is "Draft only" and trackChanges is "Actions with approval".
  // In an Outlook draft or meeting window, readOnly and commentOnly ("Edit this draft") are its only modes.
  // In Excel and PowerPoint, trackChanges is "Edits with approval" (they have no tracked changes).
  // A name the add-in does not recognise, or a file it cannot read, switches every mode off in every app.

  // Editing modes to switch off. Example: "Outlook": ["fullAutonomy"] removes Full autonomy from Outlook only.
  "disabledModes": {
    "Word": [],
    "Excel": [],
    "PowerPoint": [],
    "Outlook": []
  },

  // Tools the user must Approve before they run, and in which modes. "*" means every tool that changes something;
  // a tool's own entry overrides "*" (e.g. "save": [] never asks for save). Full autonomy never asks, whatever is
  // listed here. A tool name the app does not have is ignored. Calls the user types with ! never ask.
  "requireApproval": {
    "Word": {},
    "Excel": { "*": ["trackChanges"] },
    "PowerPoint": { "*": ["trackChanges"] },
    "Outlook": { "*": ["trackChanges"], "delete_email": ["commentOnly", "trackChanges"] }
  }
}
